{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Rejector",
  "version": "1.0.2",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/Ewi0/cookiePolicyRejectorRD",
  "icons": {
    "16": "icons/x-16.png",
    "32": "icons/x-32.png",
    "48": "icons/x-48.png",
    "128": "icons/x-128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/x-16.png",
      "32": "icons/x-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "css": ["content/prehide.css"],
      "js": ["content/patterns.js", "content/rules.js", "content/engine.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "minimum_chrome_version": "110"
}
