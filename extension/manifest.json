{
  "manifest_version": 3,
  "name": "Cookie Policy Rejector",
  "short_name": "Rejector",
  "version": "1.0.0",
  "description": "Refuses every cookie banner before you see it. Or approves them all. Either way, you never see one again.",
  "homepage_url": "https://github.com/Ewi0/cookiePolicyRejectorRD",
  "icons": {
    "16": "icons/x-16.png",
    "32": "icons/x-32.png",
    "48": "icons/x-48.png",
    "128": "icons/x-128.png"
  },
  "action": {
    "default_title": "Cookie Policy Rejector",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/x-16.png",
      "32": "icons/x-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "css": ["content/prehide.css"],
      "js": ["content/patterns.js", "content/rules.js", "content/engine.js"]
    }
  ],
  "minimum_chrome_version": "110"
}
